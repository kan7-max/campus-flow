{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-auth-build/types/**/*.ts",
    ".next-qa-builddiag/types/**/*.ts",
    ".next-qa-direct/types/**/*.ts",
    ".next-qa-full-manual/types/**/*.ts",
    ".next-qa-manual/types/**/*.ts",
    ".next-qa-manual2/types/**/*.ts",
    ".next-qa-manual3/types/**/*.ts",
    ".next-qa-manual4/types/**/*.ts",
    ".next-qa-manual5/types/**/*.ts",
    ".next-qa-proc/types/**/*.ts",
    ".next-qa-repro/types/**/*.ts",
    ".next-qa-stable/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-qa/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
