{
  "name": "campus-taskflow",
  "version": "0.1.0",
  "private": true,
  "description": "University assignment and schedule manager with AI extraction and Google Calendar sync.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ai:eval": "node scripts/evaluate-ai-extraction.mjs",
    "qa:mvp": "node scripts/qa-mvp-flow.mjs",
    "qa:inbox": "node scripts/qa-inbox-multi-candidate.mjs",
    "qa:preprod": "node scripts/qa-preprod-readiness.mjs",
    "qa:secrets-static": "node scripts/qa-secrets-static.mjs",
    "qa:release-local": "pwsh -File scripts/qa-release-local.ps1 -Mode quick",
    "qa:release-local:full": "pwsh -File scripts/qa-release-local.ps1 -Mode full",
    "qa:release-local:eta": "pwsh -File scripts/qa-release-local.ps1 -Mode estimate",
    "qa:smoke:protected": "pwsh -File scripts/qa-smoke-protected.ps1",
    "qa:cleanup": "node scripts/cleanup-qa-demo-assignments.mjs",
    "campusflow:tools:compare:init": "node src/coding-tools-compare.js init",
    "campusflow:tools:compare:score": "node src/coding-tools-compare.js score",
    "campusflow:rag:benchmark": "node src/rag-cost-benchmark.js",
    "campusflow:model:eval:step37": "node src/model-eval-step37.js",
    "campusflow:replay:init": "node src/replay-regression.js init",
    "campusflow:replay:run": "node src/replay-regression.js run",
    "lint": "eslint src middleware.ts proxy.ts next.config.mjs tailwind.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "ai-ops:issue": "node tools/ai-ops/ai-issue-generator.mjs",
    "ai-ops:prompt": "node tools/ai-ops/codex-prompt-generator.mjs",
    "ai-ops:create-issue": "node tools/ai-ops/ai-ops-create-github-issue.mjs",
    "ai-ops:run": "node tools/ai-ops/ai-ops-runner.mjs",
    "ai-ops:labels": "node tools/ai-ops/apply-github-labels.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.107.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.474.0",
    "next": "^15.5.19",
    "openai": "^4.95.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.7",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.5.19",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "postcss": "$postcss"
  }
}
