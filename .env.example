# Campus Flow app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
TASKFLOW_DEMO_MODE=1
ADMIN_EMAILS=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notify@example.com

# X API
X_BEARER_TOKEN=
# 例: https://api.x.com/2
X_API_BASE_URL=https://api.x.com/2

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 例: https://api.openai.com/v1/responses
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# Optional tuning
# 最大取得件数（1クエリあたり）
X_MAX_RESULTS=20
# 1回の収集で読む投稿数の上限（課金制御）
X_MAX_TOTAL_PER_RUN=100
# 投資/資産運用トピックとして新規保存する上限比率（例: 0.1 = 1/10）
X_INVESTMENT_POST_RATIO=0.1
# 読み取り課金の概算単価（USD/投稿）。コンソールの契約値に合わせて調整
X_POST_READ_COST_USD=0.005
# 1日の読み取りコスト上限（USD, Asia/Tokyo）
X_DAILY_COST_CAP_USD=2
# 日次ブリーフ生成時の対象日数
BRIEF_LOOKBACK_DAYS=7
# 通常ブリーフに投資トピックを含めるか（false推奨）
BRIEF_INCLUDE_INVESTMENT=false
# AI関連度の下限（0-100）。これ未満はオフトピックとして除外
MIN_AI_RELEVANCE=65
# 実用性の下限（0-100）。導入/実装が現実的でない話題を除外
MIN_PRACTICALITY=60
# askコマンドの参照日数
ASK_LOOKBACK_DAYS=7
# Focus Plan生成時の参照日数
ACTION_LOOKBACK_DAYS=7
# Focus Planに投資トピックを含めるか（false推奨）
FOCUS_INCLUDE_INVESTMENT=false
# 導入候補レポートの参照日数
ADOPTION_LOOKBACK_DAYS=7
# 導入候補レポートに投資トピックを含めるか（false推奨）
ADOPTION_INCLUDE_INVESTMENT=false
# SNS/広報投稿カレンダーの参照日数
SOCIAL_OPS_LOOKBACK_DAYS=14
# SNS/広報投稿カレンダーの生成日数
SOCIAL_OPS_DAYS=7
# channel設定がない場合の1日あたり投稿数
SOCIAL_OPS_DAILY_POSTS=1
# SNS/広報投稿に投資トピックを含めるか（false推奨）
SOCIAL_OPS_INCLUDE_INVESTMENT=false
# 外部SNSへの自動投稿は未対応・false固定推奨
SOCIAL_OPS_AUTO_POST=false
# SNS素材生成をSVGだけにするか（通常false。WindowsではPNG/GIFも生成）
SOCIAL_ASSETS_SVG_ONLY=false
# SNS素材生成の投稿数上限（0なら全件）
SOCIAL_ASSETS_LIMIT=0
# AI/チャット割り振りで作成する最大タスク数
AI_DELEGATION_MAX_TASKS=24
# askで投資トピックを常時含めるか（false時は投資系の質問時のみ自動で含める）
ASK_INCLUDE_INVESTMENT=false
# 共通記憶（Obsidian）ルート。公開リポジトリでは個人パスを入れない。
OBSIDIAN_VAULT_PATH=
# 投資専用ブリーフの参照日数
INVESTMENT_BRIEF_LOOKBACK_DAYS=7
# 投資専用ブリーフでAI関連投稿のみ対象にするか
INVESTMENT_BRIEF_REQUIRE_AI=true
# 投資専用ブリーフのAI関連度しきい値
INVESTMENT_MIN_AI_RELEVANCE=40
# リードフォローアップ間隔（日）
FOLLOWUP_CADENCE_DAYS=3
# 動的レビューで読む差分の最大文字数
REVIEW_MAX_DIFF_CHARS=12000

# 取得時点での事前フィルタ（raw保存前）
INGEST_PREFILTER_ENABLED=true
INGEST_PREFILTER_REQUIRE_KEYWORD_ACCOUNTS=true
INGEST_PREFILTER_REQUIRE_KEYWORD_QUERIES=true
INGEST_PREFILTER_MIN_KEYWORD_HITS=1
# 空ならconfig/sources.jsonのprefilter設定を使用
INGEST_ALLOWED_LANGS=
INGEST_POSITIVE_KEYWORDS=
INGEST_NEGATIVE_KEYWORDS=
# query取得時に監視アカウント投稿を除外（重複読込抑制）
X_QUERY_EXCLUDE_TRACKED_ACCOUNTS=true
# 新規追加が連続0回のAPI呼び出しが続いたら早期停止
X_MAX_CONSECUTIVE_ZERO_NEW_CALLS=3

# 自動改善（新規情報からキーワード調整）
AUTO_IMPROVE_LOOKBACK_DAYS=14
AUTO_IMPROVE_POSITIVE_TOP_N=16
AUTO_IMPROVE_NEGATIVE_TOP_N=12

# 他プロジェクト自動適用。公開用サンプルは安全側のデフォルトにする。
AUTO_APPLY_ENABLED=false
AUTO_APPLY_DRY_RUN=true
AUTO_APPLY_OVERWRITE_SCRIPTS=false

# Agentmemory (optional, secure defaults)
# 有効化（falseのままなら未使用）
AGENTMEMORY_ENABLED=false
# ローカル常駐サーバーURL
AGENTMEMORY_URL=http://127.0.0.1:3111
# trueならlocalhost以外を拒否（推奨）
AGENTMEMORY_STRICT_LOCALHOST=true
# 必要な場合のみ設定（Bearer）
AGENTMEMORY_SECRET=
# メモリの論理プロジェクト名
AGENTMEMORY_PROJECT=
# タイムアウトms
AGENTMEMORY_TIMEOUT_MS=3500
# askでAgentmemory検索を併用するか
ASK_USE_AGENTMEMORY=false
# askのコンテキスト構成（detailed|compact）
ASK_CONTEXT_MODE=detailed
# askのコンテキスト件数
ASK_CONTEXT_TOP_N=10
# askコンテキストに元投稿textを含めるか
ASK_CONTEXT_INCLUDE_TEXT=true
# textを含める場合の1件あたり最大文字数
ASK_CONTEXT_MAX_TEXT_CHARS=420
# Agentmemory検索件数
AGENTMEMORY_SEARCH_LIMIT=6
# 同期時の最大文字数
AGENTMEMORY_MAX_CONTENT_CHARS=2000
# lookback同期時の件数上限（latest-ingestは明示--limitがない限りバッチ全体）
AGENTMEMORY_SYNC_LIMIT=40
# 同期対象の参照日数
MEMORY_SYNC_LOOKBACK_DAYS=14
# 保存TTL（日）
AGENTMEMORY_TTL_DAYS=120
# 再帰リスク回避の安全弁（agentmemory側設定）
AGENTMEMORY_ALLOW_AGENT_SDK=false

# RAGコストベンチ
RAG_BENCH_BASELINE_TOP_N=10
RAG_BENCH_COMPACT_TOP_N=6
RAG_BENCH_OUTPUT_TOKENS_EST=700
RAG_BENCH_INPUT_COST_PER_1M=0.4
RAG_BENCH_OUTPUT_COST_PER_1M=1.6

# Step 3.7 Flash比較評価（OpenRouter）
OPENROUTER_API_KEY=
STEP37_MODEL=stepfun-ai/step-3.7-flash
STEP37_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=ai-intel-rag-pipeline
MODEL_EVAL_MAX_CASES=5
MODEL_EVAL_CONTEXT_TOP_N=8
MODEL_EVAL_USE_JUDGE=true
MODEL_EVAL_JUDGE_MODEL=gpt-4.1-mini

# replay型回帰テスト
REPLAY_CASES_FILE=
REPLAY_CASE_TIMEOUT_MS=180000
REPLAY_MAX_CASES=20
